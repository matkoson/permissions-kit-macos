#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "${ROOT}"
CODEGRAPH="${CODEGRAPH_BIN:-$(command -v codegraph || true)}"
if [[ -z "${CODEGRAPH}" && -x /Users/matkoson/bin/codegraph ]]; then
	CODEGRAPH=/Users/matkoson/bin/codegraph
fi
if [[ -z "${CODEGRAPH}" ]]; then
	echo "codegraph executable not found on PATH (set CODEGRAPH_BIN)" >&2
	exit 1
fi
if [[ -d .codegraph ]]; then
	"${CODEGRAPH}" update || "${CODEGRAPH}" init
else
	"${CODEGRAPH}" init
fi
